.dart_tool/
.packages
.pub-cache/
.pub/
/build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart.tmp

# Android
/android/.gradle/
/android/local.properties
/android/captures/
/android/app/debug/
/android/app/profile/
/android/app/release/
*.apk
*.aab
