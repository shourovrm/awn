*.py[cod]
.venv/
.ipynb_checkpoints/

# design mockups and taste-skill working files (local only)
.design-mockups/
.taste-skill/

# model files and data packs (mirrored in the models and data releases, not in git)
awn-models/
awn-data/
awn-data-v2/

# Gradle and Android build outputs
.gradle/
build/
