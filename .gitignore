# Local-only: exported chat sessions and Claude Code settings
/sessions/
/.claude/

# Secrets: signing keys, passwords, env files
*.jks
*.keystore
key.properties
.env
.env.*
!.env.example

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
/build/
.flutter-plugins
.flutter-plugins-dependencies
*.g.dart.tmp

# Android
/android/.gradle/
/android/local.properties
/android/captures/
/android/app/debug/
/android/app/profile/
/android/app/release/
*.apk
*.aab
*.ap_
*.dex

# iOS / macOS (in case Flutter generates them)
/ios/Pods/
/ios/.symlinks/
**/xcuserdata/

# IDEs and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Model weights, datasets and audio: downloaded at runtime or hosted elsewhere, never committed
*.onnx
*.onnx.data
*.pt
*.safetensors
*.mlpackage/
/data/
/models/
*.mp3
*.wav

# Python (training and data scripts)
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
