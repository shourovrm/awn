  "excluded": [
    {
      "ref": "2:186",
      "reason": "Allah's reply to the one who asks, not a request."
    },
    {
      "ref": "2:260",
      "reason": "Ibrahim asks to be shown how the dead are given life; a request for a sign, not a dua to repeat."
    },
    {
      "ref": "5:25",
      "reason": "Musa asks to be separated from a specific defiant people, which is asking for a verdict against them, not for a ruling or help."
    },
    {
      "ref": "7:155 (first part)",
      "reason": "Musa's question and complaint before the request; the dua starts at \"You are our protector\"."
    },
    {
      "ref": "8:32",
      "reason": "Said by disbelievers who challenge Allah."
    },
    {
      "ref": "10:88",
      "reason": "Musa's prayer against Pharaoh and his chiefs."
    },
    {
      "ref": "11:45",
      "reason": "Nuh pleads for his son, who then proved to be a disbeliever."
    },
    {
      "ref": "14:38-39",
      "reason": "Praise and acknowledgement of Allah's knowledge; no request."
    },
    {
      "ref": "18:24",
      "reason": "A hope about guidance, said in the third person, not a request."
    },
    {
      "ref": "23:106-107",
      "reason": "The plea of the people of the Fire."
    },
    {
      "ref": "26:86",
      "reason": "Ibrahim asks forgiveness for his father, who died a disbeliever; Ibrahim later disowned him (9:114)."
    },
    {
      "ref": "28:17",
      "reason": "A pledge by Musa, not a request."
    },
    {
      "ref": "28:22",
      "reason": "A hope for guidance spoken in the third person, not addressed to Allah."
    },
    {
      "ref": "35:34-35",
      "reason": "Praise by the people of Paradise; no request."
    },
    {
      "ref": "35:37",
      "reason": "The plea of the people of the Fire."
    },
    {
      "ref": "38:41",
      "reason": "Ayyub's complaint of harm with no stated request; his request is 21:83, which is included."
    },
    {
      "ref": "40:60",
      "reason": "Allah's command to call on Him, not a dua."
    },
    {
      "ref": "44:12",
      "reason": "Said by disbelievers under punishment."
    },
    {
      "ref": "71:26-27",
      "reason": "Nuh's prayer against the disbelievers of his people."
    },
    {
      "ref": "71:28 (last clause)",
      "reason": "\"Do not increase the wrongdoers except in destruction\" is a prayer against others; the dua ends before it."
    }
  ],
